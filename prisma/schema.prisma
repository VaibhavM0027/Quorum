// Quorum — AI-powered Group Discussion platform
// Database schema. PostgreSQL via Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  HOST
  PARTICIPANT
}

enum DiscussionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum DiscussionMode {
  FREE_FLOW // participants drive the conversation; AI observes and nudges
  AI_MODERATED // AI actively poses questions and balances participation
}

enum Relevance {
  PENDING
  HIGHLY_RELEVANT
  RELEVANT
  PARTIALLY_RELEVANT
  IRRELEVANT
}

enum AiEventKind {
  WELCOME // AI moderator welcome and turn-taking instructions
  QUESTION // AI asked the room a question
  NUDGE // AI encouraged a quiet participant
  SILENCE // AI flagged that nobody is speaking
  RELEVANCE // AI flagged drift away from the topic
  SUMMARY // AI posted a checkpoint summary
}

enum ReportKind {
  INDIVIDUAL
  OVERALL
  TRANSCRIPT
}

enum RecordingStatus {
  RECORDING // capture is in progress; no file has been stored yet
  READY // the audio file is stored and playable
  FAILED // capture ended without a usable file
}

enum TranscriptStatus {
  PARTIAL
  FINAL
}

enum TurnState {
  IDLE
  AI_SPEAKING
  OPEN
  PARTICIPANT_SPEAKING
}

enum TurnRequestStatus {
  REQUESTED
  GRANTED
  COMPLETED
  PASSED
  CANCELLED
}

enum TurnRequestSource {
  PARTICIPANT
  AI
  HOST
}

enum AiSpeechReceiptStatus {
  PENDING
  COMPLETED
  FAILED
  SKIPPED
}

/**
 * The life of one invitation the moderator offered to a participant.
 * An invitation is how the moderator hands the floor over, so its outcome is
 * the evidence behind the participation score: did the participant take the
 * floor, ask to be excused, say nothing, or lose their microphone? Only
 * `UNANSWERED` carries a penalty.
 */
enum InvitationStatus {
  PENDING // offered; the participant has not been heard from yet
  ANSWERED // the participant took the floor and spoke
  PASSED // the participant asked to be excused, which is respected
  UNANSWERED // the participant never responded, even after a second check
  TECHNICAL // could not respond because of a microphone or connection problem
  WITHDRAWN // somebody else took the floor before the invitation was taken up
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hostedDiscussions Discussion[]            @relation("HostedDiscussions")
  memberships       DiscussionParticipant[]
  messages          ChatMessage[]
  resets            PasswordReset[]
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Discussion lifecycle
// ---------------------------------------------------------------------------

model Discussion {
  id       String           @id @default(cuid())
  title    String
  topic    String
  context  String           @default("")
  rules    String           @default("")
  hostId   String
  /// Human friendly code participants type in, e.g. "K7QM2P".
  joinCode String           @unique
  status   DiscussionStatus @default(SCHEDULED)
  mode     DiscussionMode   @default(AI_MODERATED)

  scheduledAt     DateTime
  durationMin     Int      @default(30)
  maxParticipants Int      @default(12)

  aiEnabled            Boolean @default(true)
  transcriptionEnabled Boolean @default(true)
  /**
   * How long the room may stay quiet before the moderator acts on it. The
   * recommended setting is close to six seconds: long enough that a thinking
   * pause inside a speech is never mistaken for the end of a turn, short
   * enough that a dead room is picked up before it stalls.
   */
  silencePromptSec     Int     @default(6)
  /**
   * How long an invited participant is given to respond before the moderator
   * checks in on them, and then before the invitation is recorded as
   * unanswered.
   */
  inviteResponseSec    Int     @default(12)
  /// Maximum time allowed for one participant turn.
  turnDurationSec      Int     @default(120)

  /**
   * Where the conversation-management engine believes the room is right now
   * (see `src/lib/conversation.ts`). Stored rather than derived on each client
   * so every browser in the room shows the same state, and so the decision that
   * produced it stays auditable.
   */
  conversationState   String    @default("IDLE")
  conversationStateAt DateTime?

  /**
   * Last moment the moderator's voice was audible in the room, reported by the
   * browsers playing it back. Used to keep the moderator silent while it is
   * already speaking.
   */
  lastAiSpokeAt         DateTime?
  /**
   * Server-authoritative timestamp until which the AI moderator holds the
   * floor and participant microphones remain locked on LiveKit. Cleared early
   * when TTS finishes, and bounded so a disconnected browser can never leave
   * the room permanently muted.
   */
  aiSpeakingUntil       DateTime?
  /** Participant currently holding the speaking floor, if any. */
  activeSpeakerId       String?
  /** Set while the host has paused the meeting. */
  pausedAt              DateTime?
  /** Ensures the AI welcome/topic introduction is posted once per session. */
  welcomePosted         Boolean @default(false)
  /** Ensures the AI closing summary is posted once when the meeting ends. */
  summaryPosted         Boolean @default(false)

  /// Server-authoritative floor state; all microphones are denied outside a turn.
  turnState               TurnState @default(IDLE)
  activeTurnParticipantId String?
  turnStartedAt           DateTime?
  turnEndsAt              DateTime?
  activeAiSpeechEventId   String?   @unique
  aiSpeechDeadlineAt      DateTime?

  /// Breakout rooms split a large room into groups small enough to talk in.
  /// Off by default: a discussion runs as one room until the host asks for it.
  breakoutEnabled   Boolean @default(false)
  /// How many students the host wants in each breakout room. Drives how many
  /// rooms are needed for the students who are actually present.
  breakoutGroupSize Int     @default(8)

  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  host                User                    @relation("HostedDiscussions", fields: [hostId], references: [id], onDelete: Cascade)
  participants        DiscussionParticipant[]
  segments            TranscriptSegment[]
  aiEvents            AiEvent[]
  invitations         Invitation[]
  turnRequests        TurnRequest[]
  activeAiSpeechEvent AiEvent?                @relation("ActiveAiSpeech", fields: [activeAiSpeechEventId], references: [id], onDelete: SetNull)
  messages            ChatMessage[]
  evaluations         Evaluation[]
  reports             Report[]
  recordings          Recording[]

  @@index([hostId, status])
  @@index([status, scheduledAt])
}

model DiscussionParticipant {
  id           String @id @default(cuid())
  discussionId String
  userId       String
  displayName  String

  isHost               Boolean   @default(false)
  joinedAt             DateTime?
  leftAt               DateTime?
  removed              Boolean   @default(false)
  micLocked            Boolean   @default(false)
  transcriptionConsent Boolean   @default(false)
  consentAt            DateTime?
  /**
   * Set while this participant's own browser reports it is actively transcribing
   * their microphone. It is the positive evidence that a participant is being
   * captured, as opposed to merely being expected to be: without it, "who is
   * actually producing transcript" can only be guessed from consent and
   * microphone state, which does not say whether their browser supports speech
   * recognition at all.
   */
  transcribing         Boolean   @default(false)
  /**
   * When the last "I am transcribing" report arrived, so a stale claim expires.
   */
  transcribingAt       DateTime?
  createdAt            DateTime  @default(now())
  /**
   * Numbered seat at the discussion table, 1..maxParticipants. It belongs to the
   * student rather than to their browser session, so a temporary disconnect
   * reconnects to the same seat. Null once the seat is released (permanent leave
   * or removal) and for the host, who sits at the head of the table.
   */
  seatNumber           Int?

  /**
   * Breakout room this student is allocated to, 1..N. Null while breakout rooms
   * are off, and for the host, who moderates from the main room.
   */
  breakoutRoom Int?

  // -- Live audio activity, reported from LiveKit -------------------------
  /**
   * /**
   * /**
   * Last moment this participant's own audio track carried speech. LiveKit's
   * audio-activity events drive this, not the transcript: a browser knows
   * somebody has the floor seconds before the recogniser commits their
   * sentence, and the moderator must never talk over them in that gap.
   */
  lastAudioAt   DateTime?
  /**
   * Set at the moment this participant took the floor and cleared when they
   * stop. Non-null (with a fresh `lastAudioAt`) is what "currently speaking"
   * means to the conversation engine.
   */
  speakingSince DateTime?

  // -- Invitation record ---------------------------------------------------
  /// Times the moderator has offered this participant the floor.
  invitedCount          Int       @default(0)
  /// Invitations this participant took up.
  answeredInviteCount   Int       @default(0)
  /// Invitations this participant never responded to. The only penalised outcome.
  unansweredInviteCount Int       @default(0)
  /// Times this participant asked to be excused. Respected, never penalised.
  passCount             Int       @default(0)
  lastInvitedAt         DateTime?
  /**
   * Set when this participant's microphone or connection fails. A participant
   * with a recent technical issue is never penalised for missing an invitation,
   * and is left out of invitations until their audio comes back.
   */
  audioIssueAt          DateTime?

  discussion     Discussion          @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  segments       TranscriptSegment[]
  evaluation     Evaluation?
  recordings     Recording[]
  invitations    Invitation[]
  turnRequests   TurnRequest[]
  speechReceipts AiSpeechReceipt[]

  @@unique([discussionId, userId])
  // One student per seat. Postgres allows many rows with a null seat, which is
  // exactly what a released seat and the moderator position need.
  @@unique([discussionId, seatNumber])
  @@index([discussionId])
}

/**
 * One invitation the moderator offered to a participant.
 * The row is the moderator's short-term memory: it records who was asked, when,
 * and by when they were expected to answer, so a later tick can decide whether
 * the participant responded, asked to pass, or ignored the invitation — instead
 * of asking the same person again.
 */
model Invitation {
  id            String  @id @default(cuid())
  discussionId  String
  participantId String
  /// The `NUDGE` event that was spoken when the floor was offered.
  aiEventId     String?

  status            InvitationStatus @default(PENDING)
  invitedAt         DateTime         @default(now())
  /// When the response window closes. Extended once by the follow-up check.
  respondByAt       DateTime
  /// How many times the moderator has asked, including the initial offer.
  prompts           Int              @default(1)
  respondedAt       DateTime?
  /// The transcript segment that proved the participant's response, if any.
  responseSegmentId String?

  createdAt DateTime @default(now())

  discussion  Discussion            @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  participant DiscussionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([discussionId, status])
  @@index([participantId])
}

/**
 * A durable FIFO request or invitation to take the speaking floor.
 */
model TurnRequest {
  id            String            @id @default(cuid())
  discussionId  String
  participantId String
  requestId     String?
  status        TurnRequestStatus @default(REQUESTED)
  source        TurnRequestSource @default(PARTICIPANT)
  requestedAt   DateTime          @default(now())
  grantedAt     DateTime?
  finishedAt    DateTime?

  discussion  Discussion            @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  participant DiscussionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, requestId])
  @@index([discussionId, status, requestedAt])
  @@index([participantId, status])
}

// ---------------------------------------------------------------------------
// Transcription
// ---------------------------------------------------------------------------

model TranscriptSegment {
  id            String @id @default(cuid())
  discussionId  String
  participantId String

  text       String
  startedAt  DateTime
  endedAt    DateTime
  durationMs Int      @default(0)
  wordCount  Int      @default(0)
  confidence Float?
  status     TranscriptStatus @default(FINAL)
  /// Stable client-generated key that lets a live draft become its final row.
  streamId   String?
  revision   Int              @default(0)

  relevance       Relevance @default(PENDING)
  relevanceScore  Float?
  relevanceReason String    @default("")
  analysisSource  String    @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  discussion  Discussion            @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  participant DiscussionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, streamId])
  @@index([discussionId, startedAt])
  @@index([discussionId, status, startedAt])
  @@index([participantId])
}

// ---------------------------------------------------------------------------
// AI moderator output & chat
// ---------------------------------------------------------------------------

model AiEvent {
  id            String      @id @default(cuid())
  discussionId  String
  participantId String?
  kind          AiEventKind
  message       String
  source        String      @default("gemini")
  /**
   * When the assistant has told the room that it is about to act, the moment
   * that action becomes due. The room counts down to it on screen, so everyone
   * sees the same timer. Null once the action has been taken, was withdrawn
   * because somebody started speaking again, or when the event schedules
   * nothing at all.
   */
  dueAt         DateTime?
  createdAt     DateTime    @default(now())

  discussion          Discussion        @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  speechReceipts      AiSpeechReceipt[]
  activeForDiscussion Discussion?       @relation("ActiveAiSpeech")

  @@index([discussionId, createdAt])
}

/**
 * Per-browser completion receipt for the shared browser-synthesized AI voice.
 */
model AiSpeechReceipt {
  id            String                @id @default(cuid())
  aiEventId     String
  participantId String
  status        AiSpeechReceiptStatus @default(PENDING)
  completedAt   DateTime?
  createdAt     DateTime              @default(now())

  aiEvent     AiEvent               @relation(fields: [aiEventId], references: [id], onDelete: Cascade)
  participant DiscussionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([aiEventId, participantId])
  @@index([participantId, status])
}

model ChatMessage {
  id           String   @id @default(cuid())
  discussionId String
  userId       String
  name         String
  text         String
  createdAt    DateTime @default(now())

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([discussionId, createdAt])
}

// ---------------------------------------------------------------------------
// Evaluation & reports
// ---------------------------------------------------------------------------

model Evaluation {
  id            String @id @default(cuid())
  discussionId  String
  participantId String @unique

  overallScore     Float?
  speakingMs       Int    @default(0)
  contributions    Int    @default(0)
  wordCount        Int    @default(0)
  participationPct Float  @default(0)

  relevantCount   Int @default(0)
  partialCount    Int @default(0)
  irrelevantCount Int @default(0)

  averageRelevance Float?

  /// Per-dimension scores: [{ key, label, weight, score, rationale }]
  dimensions Json   @default("[]")
  /// Bullet points: { strengths: string[], improvements: string[], evidence: string[] }
  notes      Json   @default("{}")
  summary    String @default("")

  incomplete       Boolean @default(false)
  incompleteReason String?

  source String  @default("gemini")
  model  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discussion  Discussion            @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  participant DiscussionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([discussionId])
}

model Report {
  id               String     @id @default(cuid())
  discussionId     String
  participantId    String?
  kind             ReportKind
  createdAt        DateTime   @default(now())
  lastDownloadedAt DateTime?

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@index([discussionId, kind])
}

// ---------------------------------------------------------------------------
// Session recordings
// ---------------------------------------------------------------------------

/**
 * One stored audio recording of a discussion.
 * The audio itself lives in the recording store on disk (see
 * `src/lib/recordings.ts`); this row is the durable record of what was
 * captured, who captured it and where the file is. Keeping the bytes out of
 * Postgres keeps the database small and lets the file be streamed straight to
 * the browser with range requests.
 */
model Recording {
  id                      String  @id @default(cuid())
  discussionId            String
  /**
   * The participant whose browser captured the room mix. A recording is made
   * from one client so the room produces a single file rather than one clip per
   * student. Nulled if that participant's membership is later deleted.
   */
  capturedByParticipantId String?

  status     RecordingStatus @default(RECORDING)
  /// Path of the audio file relative to the recording store root.
  storageKey String?
  mimeType   String          @default("audio/webm")
  byteSize   Int             @default(0)
  durationMs Int             @default(0)

  startedAt DateTime  @default(now())
  endedAt   DateTime?
  /// Why the capture failed, when `status` is FAILED.
  error     String    @default("")

  createdAt DateTime @default(now())

  discussion Discussion             @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  capturedBy DiscussionParticipant? @relation(fields: [capturedByParticipantId], references: [id], onDelete: SetNull)

  @@index([discussionId, startedAt])
}
