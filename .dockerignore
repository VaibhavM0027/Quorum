# Build context exclusions for the Docker image.
node_modules
.next
.git
.gitignore

# Never bake secrets into an image.
.env
.env.*
!.env.example

# Development and tooling artefacts.
tests
*.log
npm-debug.log*
tsconfig.tsbuildinfo
README.md
Dockerfile
.dockerignore
docker-compose.yml

# Local session recordings. The image creates an empty store of its own, and
# copying capture files into every build would bloat the layer for no benefit.
data
