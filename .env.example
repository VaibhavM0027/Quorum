# -----------------------------------------------------------------------------
# Quorum environment. Copy to `.env` and fill in. Never commit the real `.env`.
# -----------------------------------------------------------------------------

# --- Core ---------------------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/quorum_app"
# Must be at least 32 characters.
JWT_SECRET="replace-with-a-long-random-string-at-least-32-characters"
# Public URL of this app (used for invite links / emails).
APP_URL="http://localhost:4000"
PORT="4000"
# Set to "on" when the app runs behind a trusted reverse proxy.
TRUST_PROXY="off"
# Leave blank in local dev. Set to "1" in production (HTTPS).
COOKIE_SECURE=""

# --- AI (Google Gemini) -------------------------------------------------------
# Server-side only. NEVER prefix with NEXT_PUBLIC_.
AI_ENABLED="on"
GEMINI_API_KEY=""
GEMINI_FLASH_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
# Google retires old models for new keys, so prefer rolling aliases.
# Fast model handles high-volume calls (relevance scoring, live nudges).
GEMINI_FAST_MODEL="gemini-flash-lite-latest"
# Smart model handles evaluation and report writing; falls back to the fast model.
GEMINI_SMART_MODEL="gemini-3.6-flash"
# Free-tier keys rate limit aggressively; keep this low.
GEMINI_CONCURRENCY="1"
# Hard ceiling on AI calls per discussion room.
AI_MAX_CALLS_PER_ROOM="600"

# --- Rubric -------------------------------------------------------------------
# Order: topic_relevance, communication, knowledge, participation, reasoning, listening
RUBRIC_WEIGHTS="25,20,20,15,10,10"
# Who can read a participant's individual report: "own" | "all"
REPORT_VISIBILITY="own"

# --- LiveKit (real-time audio/video) ------------------------------------------
# Server-side API endpoint. Use https://<project>.livekit.cloud in production.
LIVEKIT_HOST="http://127.0.0.1:7880"
LIVEKIT_API_KEY="quorum"
LIVEKIT_API_SECRET="replace-with-a-long-random-string-at-least-32-characters"
# Browser WebSocket URL. For Cloud set wss://<project>.livekit.cloud.
# If this is set to a remote endpoint while LIVEKIT_HOST is still the local
# default above, the server API endpoint is derived from this URL.
LIVEKIT_URL=""

# --- Live transcription -------------------------------------------------------
# Language the browser speech recogniser listens for (must be NEXT_PUBLIC_ so the
# browser can read it). Indian English accents are recognised notably better with
# "en-IN"; "en-US" is the recogniser default.
NEXT_PUBLIC_SPEECH_LANG="en-US"
# Optional browser/server transcript diagnostics. Keep disabled in production.
NEXT_PUBLIC_TRANSCRIPT_DEBUG=""
TRANSCRIPT_DEBUG=""

# --- Session recordings -------------------------------------------------------
# Where stored session recordings are written. Relative paths resolve against
# the app root. Mount a persistent disk here in production: a container that is
# rebuilt loses anything written to its own filesystem.
RECORDING_DIR="data/recordings"
# Largest single recording accepted, in MB.
RECORDING_MAX_MB="200"

# --- Email (optional) ---------------------------------------------------------
# Without SMTP, password-reset links are shown in the UI instead of emailed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Quorum <noreply@localhost>"

# --- Seed / bootstrap accounts ------------------------------------------------
SEED_HOST_EMAIL="host@quorum.local"
SEED_HOST_NAME="Discussion Host"
SEED_PARTICIPANT_EMAIL="participant@quorum.local"
SEED_PARTICIPANT_NAME="Demo Participant"
# Optional. Required only if you want `npm run seed` to create accounts.
SEED_PASSWORD=""
