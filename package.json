{
  "name": "quorum",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered Group Discussion platform: live audio/video GD, automatic transcription, AI-assisted moderation and PDF evaluation reports.",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@livekit/agents": "^1.10.0",
    "@livekit/rtc-node": "^1.2.2",
    "@prisma/client": "^6.16.2",
    "@types/three": "^0.187.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.3",
    "jose": "^6.1.0",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "lucide-react": "^0.544.0",
    "next": "^16.4.5",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.17.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.4",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  }
}
